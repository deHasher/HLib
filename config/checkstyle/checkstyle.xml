<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
	<property name="charset" value="UTF-8"/>
	<property name="tabWidth" value="4"/>
	<property name="severity" value="error"/>

	<module name="RegexpSingleline">
		<property name="fileExtensions" value="java"/>
		<property name="format" value="[ \t]+$"/>
		<property name="maximum" value="0"/>
		<property name="message" value="Trailing whitespace is not allowed."/>
	</module>

	<module name="RegexpSingleline">
		<property name="fileExtensions" value="java"/>
		<property name="format" value="^ +\S"/>
		<property name="maximum" value="0"/>
		<property name="message" value="Use tabs for indentation; one tab equals four spaces."/>
	</module>

	<module name="RegexpMultiline">
		<property name="fileExtensions" value="java"/>
		<property name="format" value="\R\z"/>
		<property name="matchAcrossLines" value="true"/>
		<property name="maximum" value="0"/>
		<property name="message" value="A newline at the end of the file is not allowed."/>
	</module>

	<module name="TreeWalker">
		<module name="OuterTypeFilename"/>
		<module name="OneTopLevelClass"/>
		<module name="NoLineWrap"/>
		<module name="RedundantImport"/>
		<module name="UpperEll"/>
		<module name="EmptyLineSeparator">
			<property name="tokens" value="PACKAGE_DEF"/>
		</module>
	</module>
</module>